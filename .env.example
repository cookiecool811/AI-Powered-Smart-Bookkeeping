# 本地运行时复制为 .env，或在部署平台（Render）环境变量中配置

# Supabase PostgreSQL 连接字符串
# 格式: postgresql://postgres:你的数据库密码@db.项目ref.supabase.co:5432/postgres
DATABASE_URL=

ZHIPUAI_API_KEY=你的智谱API_KEY
ZHIPUAI_MODEL=glm-4.7-flash
PORT=5000

# 邮箱发送配置（把 Excel 报表发到邮箱）
# SMTP_HOST: QQ邮箱 smtp.qq.com，163邮箱 smtp.163.com，Gmail smtp.gmail.com
# SMTP_PORT: 465(SSL) 或 587(STARTTLS)
# SMTP_USER: 发件邮箱地址
# SMTP_PASSWORD: 邮箱 SMTP 授权码（不是登录密码）
# MAIL_TO: 收件邮箱地址
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
